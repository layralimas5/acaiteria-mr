# Credenciais do Supabase.
#
# Copie este arquivo para `.env` e preencha com os valores do seu projeto:
# Supabase > Project Settings > API.
#
# A chave `anon` é pública (vai no navegador). Quem protege os dados é o Row
# Level Security do banco. NUNCA coloque aqui a `service_role`.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
