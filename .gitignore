# Documentos comerciais do cliente (contrato assinado, propostas).
# São da relação com a loja, não do código, e não têm por que viver no
# repositório do site.
Contrato*.docx
Contrato*.pdf

# Lixo do sistema
.DS_Store
Thumbs.db
desktop.ini

# Local Netlify folder
.netlify

# Segredos. O site tem o próprio .gitignore, mas um arquivo de ambiente criado
# por engano na raiz não pode escapar por falta de regra aqui.
.env
.env.*
!.env.example
